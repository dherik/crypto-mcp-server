    "coingecko",
    "bitcoin",
    "ethereum"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
