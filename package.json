{
  "name": "crypto-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for crypto and finance data via CoinGecko",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crypto-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --test \"build/test/*.test.js\"",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "engines": {
